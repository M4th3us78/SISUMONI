# Copie este arquivo para .env.production e preencha com valores reais.
# .env.production NUNCA deve ser commitado (já está no .gitignore).

# ── Banco de dados ──────────────────────────────────────
SPRING_DATASOURCE_USERNAME=sisumoni_user
SPRING_DATASOURCE_PASSWORD=troque-por-uma-senha-forte

# ── E-mail (recuperação de senha) ───────────────────────
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=

# ── JWT ──────────────────────────────────────────────────
# Gere um valor real com: openssl rand -base64 48
# NÃO use um valor curto ou previsível — isso assina os tokens de login.
JWT_SECRET=troque-por-um-valor-gerado-com-openssl-rand
JWT_EXPIRATION_MS=86400000

# ── Administrador principal ─────────────────────────────
# O application.yaml tem "Admin@2026!" como padrão de DESENVOLVIMENTO,
# público no repositório. TROQUE OBRIGATORIAMENTE em produção.
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_SENHA=troque-por-uma-senha-forte

# ── Domínio e Let's Encrypt ─────────────────────────────
DOMAIN=seu-dominio.com.br
CERTBOT_EMAIL=seu-email@exemplo.com
